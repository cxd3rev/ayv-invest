# Copy this file to .env.local and fill in your own Supabase project values.
# .env.local is ignored by Git. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Market data is requested only on the server.
# "yahoo" is the built-in provider (stocks, ETFs, and crypto). No key is required.
# Do not put a market-data secret in a NEXT_PUBLIC_ variable.
MARKET_DATA_PROVIDER=yahoo
